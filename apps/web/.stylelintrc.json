{
	"extends": ["stylelint-config-standard", "stylelint-config-css-modules"],
	"rules": {
		"selector-class-pattern": [
			"^[a-z][a-zA-Z0-9]*$",
			{ "message": "Class names should be camelCase (e.g. .searchField)" }
		],
		"custom-property-pattern": [
			"^[a-z][a-zA-Z0-9]*$",
			{
				"message": "Custom properties should be camelCase (e.g. --backgroundPrimary)"
			}
		]
	}
}
